---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPlanner from '../../components/ContentPlanner';
import SEOContentSection from '../../components/SEOContentSection.astro';
import { ui, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const supportedLocales: SupportedLanguage[] = ['es', 'pt', 'de', 'fr', 'ja'];
  return supportedLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const currentLang = lang || 'en';
const title = ui[currentLang]?.['site.title'] || ui.en['site.title'];
const description = ui[currentLang]?.['site.description'] || ui.en['site.description'];
---

<BaseLayout
  lang={currentLang}
  title={title}
  description={description}
>
  <ContentPlanner client:load currentLang={currentLang} />
  <SEOContentSection lang={currentLang} />
</BaseLayout>
