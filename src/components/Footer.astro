---
import { languages, ui, type SupportedLanguage } from '../i18n/ui';

interface Props {
  currentLang: SupportedLanguage;
}

const { currentLang } = Astro.props;
const t = (key: keyof typeof ui['en']) => ui[currentLang]?.[key] ?? ui['en'][key];
---

<footer class="mt-20 border-t border-[#22396F]/20 bg-[#fcfaf5] py-12 transition-colors duration-200 dark:border-[#22396F]/60 dark:bg-[#010736]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      
      <!-- Brand & Privacy Promise -->
      <div class="space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#22396F] text-[#FCF1D0]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </div>
          <span class="font-bold tracking-tight text-[#010736] dark:text-[#FCF1D0]">PostQueue</span>
        </div>
        <p class="text-xs leading-relaxed text-[#22396F]/80 dark:text-[#FCF1D0]/70">
          {t('privacy.guarantee')}
        </p>
        <div class="flex flex-wrap gap-2 pt-1">
          <span class="inline-flex items-center gap-1 rounded-md bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            100% Client-Side
          </span>
          <span class="inline-flex items-center gap-1 rounded-md bg-[#22396F]/10 px-2 py-0.5 text-[11px] font-semibold text-[#22396F] dark:bg-[#22396F]/40 dark:text-[#FCF1D0]">
            Offline Ready
          </span>
          <span class="inline-flex items-center gap-1 rounded-md bg-[#FCF1D0]/20 px-2 py-0.5 text-[11px] font-semibold text-[#010736] dark:bg-[#FCF1D0]/10 dark:text-[#FCF1D0]">
            Zero Tracking
          </span>
        </div>
      </div>

      <!-- Quick Language Navigation -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#010736] dark:text-[#FCF1D0]">
          {t('nav.language')}
        </h4>
        <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
          {Object.entries(languages).map(([code, item]) => {
            const href = code === 'en' ? '/' : `/${code}/`;
            return (
              <a
                href={href}
                class="flex items-center gap-1.5 text-[#22396F] transition hover:text-[#010736] dark:text-[#FCF1D0]/80 dark:hover:text-[#FCF1D0]"
              >
                <span>{item.flag}</span>
                <span>{item.name}</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Creator Support & External Links -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#010736] dark:text-[#FCF1D0]">
          Developer & Open Source
        </h4>
        <div class="flex flex-col gap-2 text-xs text-[#22396F] dark:text-[#FCF1D0]/80">
          <a
            href="https://buymeacoffee.com/kisharadilz"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 font-bold text-[#0D1C42] transition hover:text-[#22396F] dark:text-[#FCF1D0] dark:hover:text-white"
          >
            <span>☕</span>
            <span class="underline underline-offset-2">Buy Me a Coffee (Kishara Dilz)</span>
          </a>
          <a
            href="https://github.com/postqueue/postqueue.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 transition hover:text-[#010736] dark:hover:text-[#FCF1D0]"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
            <span>GitHub Repository</span>
          </a>
          <span class="text-xs opacity-75">
            Built with Astro, React & Tailwind CSS. Free & Open Source for Creators.
          </span>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 flex flex-col items-center justify-between border-t border-[#22396F]/15 pt-6 text-center text-xs text-[#22396F]/70 sm:flex-row dark:border-[#22396F]/50 dark:text-[#FCF1D0]/60">
      <p>© {new Date().getFullYear()} PostQueue. Free for all creators.</p>
      <p class="mt-2 sm:mt-0">Designed for TikTok, Instagram Reels & YouTube Shorts workflows.</p>
    </div>
  </div>
</footer>
